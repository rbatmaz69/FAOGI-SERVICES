# FAOGI SERVICES – Apache-Konfiguration für all-inkl.com (Shared Hosting)

# --- HTTPS erzwingen ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Auf HTTPS umleiten (außer bereits HTTPS)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Single-Page-App: bestehende Dateien/Ordner direkt ausliefern,
  # alles andere auf index.html leiten.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# --- Kompression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Browser-Caching für statische Assets ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Sicherheit: sensible Dateien sperren ---
<FilesMatch "(^\.|\.(json|md|lock|ts|tsx)$)">
  Require all denied
</FilesMatch>

# index.html und Konfiguration nicht im Verzeichnislisting zeigen
Options -Indexes
